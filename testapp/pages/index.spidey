<div class="glass-panel">
    <h1>Spidey Tracker</h1>
    <p style="text-align: center; color: var(--text-secondary); margin-bottom: 2rem;">
        Advanced Interactive CRUD with Vanilla JS
    </p>

    <!-- Create (Add Task) -->
    <form id="taskForm" class="input-group" onsubmit="addTask(event)">
        <input type="text" id="taskInput" placeholder="What needs to be done?" autocomplete="off" required>
        <button type="submit">Add Task</button>
    </form>

    <!-- Read (Task List) -->
    <div id="taskList" class="task-list">
        <!-- Tasks will be injected here by JS -->
    </div>
</div>

<script>
    // State
    let tasks = [];

    // Elements
    const taskListEl = document.getElementById('taskList');
    const taskInputEl = document.getElementById('taskInput');

    // [READ] Fetch initial tasks
    async function loadTasks() {
        try {
            const res = await fetch('/api/tasks');
            tasks = await res.json();
            renderTasks();
        } catch (err) {
            console.error("Failed to load tasks", err);
        }
    }

    // [CREATE] Add a new task
    async function addTask(event) {
        event.preventDefault();
        const title = taskInputEl.value.trim();
        if (!title) return;

        // Optimistic UI update (optional, but good for UX)
        taskInputEl.value = '';

        try {
            const res = await fetch('/api/tasks', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title })
            });
            const newTask = await res.json();
            
            // Update state and render
            tasks.push(newTask);
            renderTasks();
        } catch (err) {
            console.error("Failed to add task", err);
        }
    }

    // [UPDATE] Toggle task status
    async function toggleTask(id, currentStatus) {
        const newStatus = !currentStatus;
        
        // Optimistic UI update
        const taskIndex = tasks.findIndex(t => t.id === id);
        if (taskIndex > -1) {
            tasks[taskIndex].completed = newStatus;
            renderTasks();
        }

        try {
            await fetch(`/api/tasks/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ completed: newStatus })
            });
        } catch (err) {
            console.error("Failed to update task", err);
            // Revert on failure
            if (taskIndex > -1) {
                tasks[taskIndex].completed = currentStatus;
                renderTasks();
            }
        }
    }

    // [DELETE] Remove a task
    async function deleteTask(id, event) {
        event.stopPropagation(); // Prevent toggling when clicking delete
        
        // Find the DOM element to animate it out
        const taskEl = document.getElementById(`task-${id}`);
        if (taskEl) {
            taskEl.classList.add('fade-out');
        }

        // Wait for animation before removing from state
        setTimeout(async () => {
            tasks = tasks.filter(t => t.id !== id);
            renderTasks();
            
            try {
                await fetch(`/api/tasks/${id}`, { method: 'DELETE' });
            } catch (err) {
                console.error("Failed to delete task", err);
                loadTasks(); // Reload if failed
            }
        }, 300); // match transition duration
    }

    // Render function
    function renderTasks() {
        taskListEl.innerHTML = '';
        
        if (tasks.length === 0) {
            taskListEl.innerHTML = `
                <div style="text-align: center; color: var(--text-secondary); padding: 2rem;">
                    No tasks yet. Add one above!
                </div>
            `;
            return;
        }

        tasks.forEach(task => {
            const div = document.createElement('div');
            div.className = `task-item ${task.completed ? 'completed' : ''}`;
            div.id = `task-${task.id}`;
            
            div.innerHTML = `
                <div class="task-content" onclick="toggleTask('${task.id}', ${task.completed})">
                    <div class="task-checkbox"></div>
                    <span class="task-title">${task.title}</span>
                </div>
                <button class="delete-btn" onclick="deleteTask('${task.id}', event)">✕</button>
            `;
            
            taskListEl.appendChild(div);
        });
    }

    // Init
    loadTasks();
</script>
